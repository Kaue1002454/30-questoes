#include <stdio.h>

int main(void) {
    int opcao;
    double a, b;

    printf("1 - Somar\n2 - Subtrair\n3 - Multiplicar\n4 - Dividir\nEscolha: ");
    scanf("%d", &opcao);
    printf("Digite dois numeros: ");
    scanf("%lf %lf", &a, &b);

    switch (opcao) {
        case 1:
            printf("Resultado: %.2f\n", a + b);
            break;
        case 2:
            printf("Resultado: %.2f\n", a - b);
            break;
        case 3:
            printf("Resultado: %.2f\n", a * b);
            break;
        case 4:
            if (b == 0.0) {
                printf("Erro: divisao por zero.\n");
            } else {
                printf("Resultado: %.2f\n", a / b);
            }
            break;
        default:
            printf("Opcao invalida.\n");
            break;
    }
    return 0;
}
