#include <stdio.h>

int main(void) {
    double num, maior;

    printf("Digite o 1o numero: ");
    scanf("%lf", &maior);

    for (int i = 1; i < 10; i++) {
        printf("Digite o %do numero: ", i + 1);
        scanf("%lf", &num);
        if (num > maior) {
            maior = num;
        }
    }

    printf("Maior valor digitado: %.2f\n", maior);
    return 0;
}
