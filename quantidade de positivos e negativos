#include <stdio.h>

int main(void) {
    int pos = 0, neg = 0, zeros = 0;
    double num;

    for (int i = 0; i < 10; i++) {
        printf("Digite o %do numero: ", i + 1);
        scanf("%lf", &num);
        if (num > 0) pos++;
        else if (num < 0) neg++;
        else zeros++;
    }

    printf("Positivos: %d | Negativos: %d | Zeros: %d\n", pos, neg, zeros);
    return 0;
}
