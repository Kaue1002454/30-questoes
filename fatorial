#include <stdio.h>

int main(void) {
    int n;
    unsigned long long fat = 1;
    printf("Digite um inteiro nao negativo: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Fatorial nao definido para negativos.\n");
        return 0;
    }

    for (int i = 2; i <= n; i++) {
        fat *= (unsigned long long)i;
    }
    printf("%d! = %llu\n", n, fat);
    return 0;
}
