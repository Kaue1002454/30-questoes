#include <stdio.h>

int main(void) {
    int n, eh_primo = 1;
    printf("Digite um inteiro positivo: ");
    scanf("%d", &n);

    if (n <= 1) {
        eh_primo = 0;
    } else {
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                eh_primo = 0;
                break;
            }
        }
    }

    printf("%d %s primo.\n", n, eh_primo ? "e" : "nao e");
    return 0;
}
