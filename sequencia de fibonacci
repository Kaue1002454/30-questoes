#include <stdio.h>

int main(void) {
    int n;
    long long a = 0, b = 1, prox;

    printf("Quantos termos da sequencia de Fibonacci deseja ver? ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Quantidade invalida.\n");
        return 0;
    }

    for (int i = 1; i <= n; i++) {
        printf("%lld ", a);
        prox = a + b;
        a = b;
        b = prox;
    }
    printf("\n");
    return 0;
}
