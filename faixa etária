#include <stdio.h>

int main(void) {
    int idade;
    printf("Digite a idade: ");
    scanf("%d", &idade);

    if (idade < 0) {
        printf("Idade invalida.\n");
    } else if (idade <= 12) {
        printf("Crianca (0 a 12 anos)\n");
    } else if (idade <= 17) {
        printf("Adolescente (13 a 17 anos)\n");
    } else if (idade <= 59) {
        printf("Adulto (18 a 59 anos)\n");
    } else {
        printf("Idoso (60 anos ou mais)\n");
    }
    return 0;
}
