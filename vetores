#include <stdio.h>

#define TAM 10

int main(void) {
    double temps[TAM], soma = 0.0, media, maior, menor;
    int acima_media = 0;

    for (int i = 0; i < TAM; i++) {
        printf("Temperatura %d: ", i + 1);
        scanf("%lf", &temps[i]);
        soma += temps[i];
    }

    media = soma / TAM;
    maior = menor = temps[0];

    for (int i = 0; i < TAM; i++) {
        if (temps[i] > maior) maior = temps[i];
        if (temps[i] < menor) menor = temps[i];
        if (temps[i] > media) acima_media++;
    }

    printf("Media: %.2f\nMaior: %.2f\nMenor: %.2f\nAcima da media: %d\n",
           media, maior, menor, acima_media);
    return 0;
}
