#include <stdio.h>

int main(void) {
    int qtd;
    double nota, soma = 0.0;

    printf("Quantidade de alunos: ");
    scanf("%d", &qtd);

    if (qtd <= 0) {
        printf("Quantidade invalida.\n");
        return 0;
    }

    for (int i = 0; i < qtd; i++) {
        printf("Nota do aluno %d: ", i + 1);
        scanf("%lf", &nota);
        soma += nota;
    }

    printf("Media da turma: %.2f\n", soma / qtd);
    return 0;
}
