#include <stdio.h>

int main(void) {
    double a, b;
    printf("Digite dois numeros: ");
    scanf("%lf %lf", &a, &b);

    if (a > b) {
        printf("Maior: %.2f\n", a);
    } else if (b > a) {
        printf("Maior: %.2f\n", b);
    } else {
        printf("Os dois valores sao iguais.\n");
    }
    return 0;
}
