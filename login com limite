#include <stdio.h>

int main(void) {
    const int SENHA = 2026;
    int tentativa, usadas = 0, autenticado = 0;

    while (usadas < 3 && !autenticado) {
        printf("Senha (tentativa %d de 3): ", usadas + 1);
        scanf("%d", &tentativa);
        usadas++;

        if (tentativa == SENHA) {
            autenticado = 1;
        } else if (usadas < 3) {
            printf("Senha incorreta.\n");
        }
    }

    if (autenticado) {
        printf("Acesso autorizado\n");
    } else {
        printf("Usuario bloqueado\n");
    }
    return 0;
}
