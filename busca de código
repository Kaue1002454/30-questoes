#include <stdio.h>

#define QTD_COD 10

int main(void) {
    int codigos[QTD_COD], alvo, indice = -1;

    for (int i = 0; i < QTD_COD; i++) {
        printf("Codigo %d: ", i);
        scanf("%d", &codigos[i]);
    }

    printf("Digite o codigo para buscar: ");
    scanf("%d", &alvo);

    for (int i = 0; i < QTD_COD; i++) {
        if (codigos[i] == alvo) {
            indice = i;
            break;
        }
    }

    if (indice != -1) {
        printf("Codigo encontrado no indice %d.\n", indice);
    } else {
        printf("Codigo nao encontrado.\n");
    }
    return 0;
}
