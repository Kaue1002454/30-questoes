#include <stdio.h>

int main(void) {
    int n;
    double num, maior, menor;

    printf("Quantos numeros deseja informar? ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Quantidade invalida.\n");
        return 0;
    }

    printf("Digite o 1o numero: ");
    scanf("%lf", &num);
    maior = menor = num;

    for (int i = 1; i < n; i++) {
        printf("Digite o %do numero: ", i + 1);
        scanf("%lf", &num);
        if (num > maior) maior = num;
        if (num < menor) menor = num;
    }

    printf("Maior: %.2f | Menor: %.2f\n", maior, menor);
    return 0;
}
